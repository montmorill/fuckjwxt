# 复制为 .env 后填写；.env 已被 .gitignore 忽略
# 值不要加引号（除非含空格或 # 号）；等号两边不要有空格

# ===== 教务系统（强智 jwglxt）直接登录 =====
JWXT_BASE_URL=https://jwglxt.sdust.edu.cn
# 学号 / 工号
JWXT_ACCOUNT=
# 教务系统密码（注意：不是微信/QQ 密码）
JWXT_PASSWORD=

# ===== 学校统一身份认证 CAS（可选，走办事大厅/门户时才需要）=====
# CAS_BASE_URL=https://my.sdust.edu.cn/cas
# CAS_ACCOUNT=
# CAS_PASSWORD=

# ===== OAuth 服务 =====
# 监听端口
PORT=8787
# 对外地址（反代后改成 https://your.domain）
ISSUER=http://localhost:8787
# SQLite 文件（相对项目根目录）
DB_PATH=data/jwxt-oauth.db

# 32 字节密钥：node scripts/admin.mjs gen-key
MASTER_KEY=
# 管理 API 的令牌（至少 24 字符）：node scripts/admin.mjs gen-token
ADMIN_TOKEN=

# 允许跨域的来源，逗号分隔；留空则不发 CORS 头
CORS_ORIGINS=

# 令牌有效期（秒）
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000
AUTH_CODE_TTL=60
# 教务会话缓存（毫秒），过期后自动重新登录
JWXT_SESSION_TTL_MS=900000
# 令牌/管理接口每分钟每 IP 上限
ADMIN_RATE_LIMIT=120

# ===== CalDAV（只读课表）=====
CALDAV_USER=caldav
# 至少 24 字符：node scripts/admin.mjs gen-token
CALDAV_TOKEN=
# 仅支持 Asia/Shanghai（时间按 +08:00 转 UTC）
CALDAV_TIMEZONE=Asia/Shanghai
# 留空 = 当前学期
CALDAV_SEMESTER=
# 留空 = 从教学周历解析；格式 YYYY-MM-DD
CALDAV_SEMESTER_START=
# 节次时间，格式 1-2=08:00-09:40;3-4=10:00-11:40;...
CALDAV_PERIOD_TIMES=
# 课表缓存（毫秒）
CALDAV_CACHE_MS=300000
