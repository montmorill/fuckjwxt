# 复制为 .env 后填写；.env 已被 .gitignore 忽略
# 值不要加引号（除非含空格或 # 号）；等号两边不要有空格

# 注意：本项目不兼容旧版单用户数据库；升级请删除 data/jwxt-oauth.db。

# ===== tools/ 探测脚本使用的教务账号 =====
# 服务端不再从这些变量创建用户；用户请用 scripts/admin.mjs add-user 或 /admin/users 创建
JWXT_BASE_URL=https://jwglxt.sdust.edu.cn
JWXT_ACCOUNT=
JWXT_PASSWORD=

# ===== 学校统一身份认证 CAS（可选，走办事大厅/门户时才需要）=====
# CAS_BASE_URL=https://my.sdust.edu.cn/cas
# CAS_ACCOUNT=
# CAS_PASSWORD=

# ===== OAuth 服务 =====
# 监听端口
PORT=8787
# 对外地址（反代后改成 https://your.domain）
ISSUER=http://localhost:8787
# SQLite 文件（相对项目根目录）
DB_PATH=data/jwxt-oauth.db

# 32 字节密钥：node scripts/admin.mjs gen-key
MASTER_KEY=
# 管理 API 的令牌（至少 24 字符）：node scripts/admin.mjs gen-token
ADMIN_TOKEN=

# 允许跨域的来源，逗号分隔；留空则不发 CORS 头
CORS_ORIGINS=

# 令牌有效期（秒）
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000
AUTH_CODE_TTL=60
# 教务会话缓存（毫秒），过期后自动重新登录
JWXT_SESSION_TTL_MS=900000
# 令牌/管理接口每分钟每 IP 上限
ADMIN_RATE_LIMIT=120

# ===== 服务登录会话 =====
# 秒
SERVICE_SESSION_TTL=604800

# ===== CalDAV（只读课表，多用户）=====
# 每用户 token 用 scripts/admin.mjs add-caldav-token 或 /admin/users/{id}/caldav-tokens 签发
# 学期：默认当前学期；可在用户上用 --caldav-semester / caldavSemester 固定
# 开学日期：自动从教学周历解析；作息：config/period-times.json；时区固定 Asia/Shanghai
# 课表缓存（毫秒）
CALDAV_CACHE_MS=300000
