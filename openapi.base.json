            "type": "integer"
          }
        }
      },
      "PlanCoursesResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlanCourse"
            }
          }
        }
      },
      "MessageItem": {
        "type": "object",
        "additionalProperties": true,
        "description": "消息/公告字段随学校配置略有差异"
      },
      "MessagesResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "count": {
                "type": "integer"
              },
              "data": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/MessageItem"
                }
              }
            }
          }
        }
      },
      "OAuthMetadata": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "issuer": {
            "type": "string"
          },
          "authorization_endpoint": {
            "type": "string"
          },
          "token_endpoint": {
            "type": "string"
          },
          "revocation_endpoint": {
            "type": "string"
          },
          "userinfo_endpoint": {
            "type": "string"
          },
          "scopes_supported": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "grant_types_supported": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "code_challenge_methods_supported": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ClientCreate": {
        "type": "object",
        "required": [
          "name",
          "redirectUris"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "redirectUris": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "description": "必须是 https；localhost/127.0.0.1 允许 http；不能带 fragment"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "jwxt.read",
                "jwxt.profile",
                "offline_access"
              ]
            },
            "default": [
              "jwxt.read"
            ]
          },
          "public": {
            "type": "boolean",
            "default": false
          },
          "userId": {
            "type": "integer",
            "description": "必须提供 userId 或 account（二选一）"
          },
          "account": {
            "type": "string",
            "description": "必须提供 userId 或 account（二选一）"
          }
        }
      },
      "ClientCreated": {
        "type": "object",
        "properties": {
          "client_id": {
            "type": "string"
          },
          "client_secret": {
            "type": "string",
            "nullable": true,
            "description": "只返回这一次；public=true 时为 null"
          },
          "name": {
            "type": "string"
          },
          "redirect_uris": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "public": {
            "type": "boolean"
          },
          "user_id": {
            "type": "integer",
            "nullable": true
          },
          "account": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Client": {
        "type": "object",
        "properties": {
          "client_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "redirect_uris": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "public": {
            "type": "boolean"
          },
          "created_at": {
            "type": "integer",
            "description": "Unix 秒"
          },
          "user_id": {
            "type": "integer",
            "nullable": true
          },
          "account": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "account": {
            "type": "string"
          },
          "baseUrl": {
            "type": "string",
            "nullable": true
          },
          "disabled": {
            "type": "boolean"
          },
          "hasServicePassword": {
            "type": "boolean"
          },
          "caldavTokenCount": {
            "type": "integer"
          },
          "caldavSemester": {
            "type": "string",
            "nullable": true,
            "description": "CalDAV 固定学期，如 2026-2027-1；null 表示跟随当前学期"
          },
          "createdAt": {
            "type": "integer",
            "description": "Unix 秒"
          },
          "updatedAt": {
            "type": "integer",
            "description": "Unix 秒"
          }
        }
      },
      "UserCreate": {
        "type": "object",
        "required": [
          "account",
          "password"
        ],
        "properties": {
          "account": {
            "type": "string",
            "description": "强智学号/工号"
          },
          "password": {
            "type": "string",
            "format": "password",
            "description": "教务密码"
          },
          "baseUrl": {
            "type": "string",
            "format": "uri"
          },
          "servicePassword": {
            "type": "string",
            "format": "password",
            "description": "服务登录密码，至少 8 位；省略则不能登录 OAuth 授权页"
          },
          "caldavSemester": {
            "type": "string",
            "nullable": true,
            "description": "CalDAV 固定学期，如 2026-2027-1；省略表示跟随当前学期"
          },
          "verify": {
            "type": "boolean",
            "default": true,
            "description": "先登录教务验证再落库"
          }
        }
      },
      "UserUpdate": {
        "type": "object",
        "properties": {
          "account": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "format": "password"
          },
          "baseUrl": {
            "type": "string",
            "format": "uri"
          },
          "servicePassword": {
            "type": "string",
            "format": "password",
            "nullable": true,
            "description": "传空字符串清除"
          },
          "caldavSemester": {
            "type": "string",
            "nullable": true,
            "description": "CalDAV 固定学期，如 2026-2027-1；传空字符串清除"
          },
          "disabled": {
            "type": "boolean"
          },
          "verify": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "CalDavToken": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "label": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "integer"
          },
          "revokedAt": {
            "type": "integer",
            "nullable": true
          },
          "lastUsedAt": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "CalDavTokenCreated": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "label": {
            "type": "string",
            "nullable": true
          },
          "token": {
            "type": "string",
            "description": "只返回这一次，作为 CalDAV Basic 密码"
          }
        }
      }
    }
  }
}
