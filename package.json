{
  "name": "jwxt-oauth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "把强智教务账号包装成受 OAuth2 保护的数据 API",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --no-warnings server/index.mjs",
    "admin": "node --no-warnings scripts/admin.mjs",
    "openapi": "node --no-warnings scripts/openapi.mjs gen",
    "openapi:check": "node --no-warnings scripts/openapi.mjs check",
    "hooks": "git config core.hooksPath .githooks",
    "test:oauth": "node --no-warnings tests/oauth.mjs",
    "test:caldav": "node --no-warnings tests/caldav.mjs",
    "test:client": "node --no-warnings tests/client.mjs"
  }
}
